{
  "name": "aldeebhasan/lottie-laravel",
  "description": "This package will allow you to manage and preview lottiefiles in your laravel project",
  "type": "library",
  "version": "2.1.0",
  "license": "MIT",
  "keywords": [
    "lottie",
    "lottiefiles",
    "lottiefiles manageer",
    "lottie preview",
    "laravel"
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Aldeebhasan\\LottieLaravel\\": "src/"
    },
    "files": [
      "utilities/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Aldeebhasan\\LottieLaravel\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Hasan Deeb",
      "email": "aldeeb.91@gmail.com",
      "homepage": "https://hasan-deeb.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.5",
    "illuminate/cache": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/view": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Aldeebhasan\\LottieLaravel\\LottieLaravelServiceProvider"
      ],
      "aliases": {}
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
